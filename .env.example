# ==============================================================================
# AlgoSet — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# In production, never commit .env to version control or use default passwords.

# ------------------------------------------------------------------------------
# Core Application & Security Settings
# ------------------------------------------------------------------------------
# Secret key: In production (DEBUG=False), MUST be a secure, random string >= 40 chars
SECRET_KEY=your-secure-random-secret-key-change-in-production

# Debug mode: Set to False in production
DEBUG=True

# Allowed hosts: In production, specify explicit domains (comma-separated, NO wildcard '*')
# Example: ALLOWED_HOSTS=algoset.uz,api.algoset.uz
ALLOWED_HOSTS=*

# Code Execution Sandbox Boundary:
# When False (default in production), code execution returns an honest maintenance notice
# while preserving problem browsing, tutorials, contests, and studio workflows.
# Set to True only when an isolated execution runner service is configured.
ENABLE_CODE_EXECUTION=True

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=algoset_db
POSTGRES_USER=algoset_user
POSTGRES_PASSWORD=algoset_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# CORS & CSRF Settings
# ------------------------------------------------------------------------------
# Comma-separated list of trusted frontend origins in production
# Example: CORS_ALLOWED_ORIGINS=https://algoset.uz,https://www.algoset.uz
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# HTTPS, Cookies & Reverse Proxy (Production)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
ENABLE_HSTS=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Set to True if running behind Nginx / Cloudflare / AWS ALB with HTTPS termination
USE_X_FORWARDED_PROTO=False

# ------------------------------------------------------------------------------
# Request Payload & Upload Size Limits (in bytes)
# ------------------------------------------------------------------------------
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# ------------------------------------------------------------------------------
# Rate Limiting / Throttling (Requests per minute)
# ------------------------------------------------------------------------------
THROTTLE_ANON_RATE=120/minute
THROTTLE_USER_RATE=600/minute
THROTTLE_AUTH_RATE=30/minute
THROTTLE_EXECUTION_RATE=120/minute

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@algoset.uz

# ------------------------------------------------------------------------------
# Frontend & Startup Options
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
SEED_ON_STARTUP=False
